DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/avengers_bank
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=15
# 로그인 유지: refresh 토큰(httpOnly 쿠키) 기간, 쿠키 Secure(HTTPS 운영에서는 true), 동시 갱신 유예 (docs/SECURITY.md)
REFRESH_TOKEN_DAYS=14
REFRESH_COOKIE_SECURE=true
REFRESH_REUSE_GRACE_SECONDS=20
DB_ECHO=false
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_CHAT_MODEL=gemini-3.8-flash
DEMO_MODE=false
# 시연용 가상 입금 한도 (1회, 사용자별 하루). 비우면 100만원·300만원
CASH_DEPOSIT_MAX_AMOUNT=1000000
CASH_DEPOSIT_DAILY_LIMIT=3000000
# 다른 은행 이체 (ClearingHub, docs/INTERBANK.md). 넷(HUB_URL·HUB_API_KEY·INTERBANK_SIGNING_KEY·HUB_PUBLIC_KEY) 중 하나라도 비면 꺼진다.
# 서명은 Ed25519 하나다. 새로 등록하는 순서는 INTERBANK.md "새 환경 설정 순서"
BANK_CODE=901
HUB_URL=
# 셀프 등록(keys register-bank) 응답의 api_key. 식별용 (서명 키가 아님)
HUB_API_KEY=
# 우리 Ed25519 개인키: uv run python -m avengers_bank.domains.interbank.keys generate (이 파일에만, 저장소·채팅에 올리지 않는다)
INTERBANK_SIGNING_KEY=
# 허브 공개키: keys hub-key로 받아 허브 관리자가 따로 알려 준 지문과 같을 때만 넣는다
HUB_PUBLIC_KEY=
# 다른 은행 내 계좌 불러오기(가상 CI, ClearingHub SPEC 9절). 허브 관리자에게 받는다. 비우면 이 기능만 꺼진다
CI_KEY=
# 로그: json(기본, 한 줄에 JSON 하나) 또는 text(로컬에서 읽기 편한 형식)
LOG_LEVEL=INFO
LOG_FORMAT=json
# 선택: Sentry 오류 수집. DSN을 비워 두면 아무것도 하지 않는다
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
